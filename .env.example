# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJ...tu-anon-key
SUPABASE_SERVICE_ROLE_KEY=eyJ...tu-service-role-key
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# Server
PORT=3000
NODE_ENV=development

# CORS
CORS_ORIGIN=http://localhost:3000

# Pago por transferencia (Banca Móvil Pichincha)
BANCO_NOMBRE=Banco Pichincha
BANCO_TIPO=Cuenta de ahorros
BANCO_TITULAR=Ternurita Bebé
BANCO_CEDULA=tu-cedula-o-ruc
BANCO_CUENTA=tu-numero-de-cuenta
BANCO_TELEFONO=tu-telefono-banca-movil
